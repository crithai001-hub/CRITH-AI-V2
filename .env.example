# Copy to .env.local and fill in real values. .env.local is gitignored.
# Anything prefixed with VITE_ gets bundled into the build — never put secrets here.

VITE_BACKEND_URL=https://crith-backend.vercel.app
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Optional dev convenience. If both are set, the popup + service worker
# auto-sign-in with these credentials whenever storage is empty/stale,
# so you never see the manual login form. Leave BOTH blank to use the
# manual flow. Vite inlines these into the build, so treat dist/ as
# secret-equivalent if you set them.
VITE_DEV_AUTO_LOGIN_EMAIL=
VITE_DEV_AUTO_LOGIN_PASSWORD=
